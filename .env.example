# ---- 数据库 ----
DATABASE_URL="postgresql://deepread:deepread@localhost:5432/deepread?schema=public"

# ---- 会话签名（至少 32 字符随机串）----
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---- 部署区域：intl（新加坡/东盟，Claude/OpenAI）或 cn（中国区，DeepSeek/Qwen）----
DEPLOY_REGION="intl"

# ---- 模型路由：quick 档（关键点判定、导师提示）与 deep 档（量表评分、申诉）----
# provider 可选：anthropic | openai | deepseek | qwen | none
LLM_QUICK_PROVIDER="anthropic"
LLM_QUICK_MODEL="claude-haiku-5-5"
LLM_DEEP_PROVIDER="anthropic"
LLM_DEEP_MODEL="claude-sonnet-5-5"
LLM_TIMEOUT_MS="8000"

# 中国区示例：
# LLM_QUICK_PROVIDER="qwen"     LLM_QUICK_MODEL="qwen-turbo"
# LLM_DEEP_PROVIDER="deepseek"  LLM_DEEP_MODEL="deepseek-chat"

ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
DASHSCOPE_API_KEY=""

# 可选：覆盖接口地址（企业网关 / 代理 / 私有部署）
# ANTHROPIC_BASE_URL=""  OPENAI_BASE_URL=""  DEEPSEEK_BASE_URL=""  DASHSCOPE_BASE_URL=""

# ---- 防沉迷：每名学生每日可开始的训练节数 ----
DAILY_SESSION_LIMIT="2"
